rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Donnees utilisateur - acces prive uniquement
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Conversations partagees - lecture publique, ecriture authentifiee
    match /shared/{shareId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Arena - profils utilisateurs
    match /arena_users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Arena - posts publics
    match /arena_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Arena - commentaires
    match /arena_posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Bloquer tout le reste
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
