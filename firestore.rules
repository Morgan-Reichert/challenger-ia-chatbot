rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ─── Données utilisateur — accès privé strict ─────────────────────────────
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if isOwner(userId);
    }

    // ─── Conversations partagées ──────────────────────────────────────────────
    // Lecture publique (lien de partage), création par tout user authentifié,
    // mais seul le créateur peut modifier/supprimer ensuite.
    match /shared/{shareId} {
      allow read: if true;
      allow create: if isAuth()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth()
                            && resource.data.ownerId == request.auth.uid;
    }

    // ─── Collections héritées (arena_*, xpose_*) ─────────────────────────────
    // Leurs règles ont été retirées : aucune n'était plus utilisée par
    // l'application, mais elles laissaient ces documents lisibles par tout
    // compte authentifié. La règle terminale ci-dessous les refuse désormais.

    // ─── Daily challenges générés (cache lecture seule côté client) ──────────
    // Écriture réservée au serveur via Admin SDK (bypass des rules).
    match /daily_challenges/{dayId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Bloquer tout le reste ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
