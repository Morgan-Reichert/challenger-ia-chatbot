# ─── Mistral AI ───────────────────────────────────────────────────────────────
# Défini dans Vercel > Settings > Environment Variables
# Le proxy api/chat.js lit cette variable côté serveur (process.env)
# → la clé n'apparaît PAS dans le bundle client grâce au proxy
VITE_MISTRAL_API_KEY=votre_cle_mistral_ici

# ─── Tavily Web Search ────────────────────────────────────────────────────────
# Gratuit jusqu'à 1000 requêtes/mois — console.tavily.com
# La recherche web se fait dans api/chat.js, pas dans le bundle client
VITE_TAVILY_API_KEY=

# ─── Firebase (optionnel — active auth + sauvegarde des sessions) ─────────────
# Récupérez ces valeurs dans : Firebase Console > Paramètres du projet > Vos apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Supabase (newsletter + consentement CGU) ────────────────────────────────
# Récupérez ces valeurs dans : Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
