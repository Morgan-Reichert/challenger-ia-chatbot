# ─── Mistral AI ──────────────────────────────────────────────────────────────
# IMPORTANT : le préfixe VITE_ est OBLIGATOIRE pour que Vite expose la variable
# Nommez-la exactement VITE_MISTRAL_API_KEY dans Vercel aussi
VITE_MISTRAL_API_KEY=votre_cle_mistral_ici

# ─── Firebase (optionnel — active auth + sauvegarde des sessions) ─────────────
# Utilisez le même projet Firebase que le site Challenger IA
# Récupérez ces valeurs dans : Firebase Console > Paramètres du projet > Vos apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
