# ─── Mistral AI (SERVEUR UNIQUEMENT — sans préfixe VITE_) ────────────────────
# Défini dans Vercel > Settings > Environment Variables sans préfixe VITE_
# Le proxy api/chat.js lit cette variable via process.env côté serveur
# → la clé n'apparaît JAMAIS dans le bundle client
MISTRAL_API_KEY=votre_cle_mistral_ici

# ─── Tavily Web Search (SERVEUR UNIQUEMENT — sans préfixe VITE_) ─────────────
# Gratuit jusqu'à 1000 requêtes/mois — console.tavily.com
# La recherche web se fait dans api/chat.js, pas dans le bundle client
TAVILY_API_KEY=

# ─── Firebase (optionnel — active auth + sauvegarde des sessions) ─────────────
# Récupérez ces valeurs dans : Firebase Console > Paramètres du projet > Vos apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Supabase (newsletter + consentement CGU) ────────────────────────────────
# Récupérez ces valeurs dans : Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# SERVEUR — Service role (utilisé par api/chat.js pour rate-limit + crédits)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Firebase Admin SDK (SERVEUR — vérifie les ID tokens côté chat/arena) ────
# Console Firebase > Paramètres du projet > Comptes de service > Générer une
# nouvelle clé privée. Encoder les sauts de ligne de la private key en \\n.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Rate-limit / quotas (SERVEUR — optionnels, valeurs par défaut OK) ───────
# CHAT_RATE_LIMIT_PER_MIN=30
# CHAT_FREE_DAILY_LIMIT=20
# CHAT_PRO_DAILY_LIMIT=150

# ─── Cron daily challenges (SERVEUR — utilisé par api/generate-challenges.js)
# Token bearer auto-généré, à passer dans le cron Vercel pour autoriser le job
CRON_SECRET=

# ─── STARIAX — centre de contrôle produit ────────────────────────────────────
# Maintenance à distance, logo saisonnier, offres, report d'erreurs.
# Tant que l'ID produit est vide, l'intégration reste TOTALEMENT inactive.
#
# ⚠️ Vérifier l'ID dans STARIAX avant activation : il doit pointer sur la fiche
#    Challenger IA. Un mauvais ID = un tiers peut couper l'app à distance.
#
# CLIENT (exposées dans le bundle — aucune donnée sensible ici)
VITE_STARIAX_BASE=https://stariax-app.vercel.app
VITE_STARIAX_PRODUCT_ID=
# Token de report d'erreurs — public par design (write-only vers l'ingest)
VITE_STARIAX_INGEST_TOKEN=
#
# SERVEUR — lues par middleware.ts (edge). Mêmes valeurs, sans préfixe VITE_.
STARIAX_BASE=https://stariax-app.vercel.app
STARIAX_PRODUCT_ID=
#
# SERVEUR — secret produit pour la résolution des versions beta (api/beta.js).
# DOIT rester serveur : il autorise la lecture du statut beta de n'importe quel
# utilisateur. Distinct du token d'ingest, qui est public et en écriture seule.
# Tant qu'il est vide, aucun utilisateur n'est inscrit à une beta (fail-open).
STARIAX_PRODUCT_SECRET=
