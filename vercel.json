{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/generate-challenges",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/reengagement",
      "schedule": "0 10 * * 1"
    }
  ]
}
